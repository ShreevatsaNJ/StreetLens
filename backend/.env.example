# Server Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=streetlens-secure-dev-key-2026

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streetlens_db

# File Storage Paths (Relative to backend/)
UPLOAD_FOLDER=storage/uploads
ENHANCED_FOLDER=storage/enhanced
ANNOTATED_FOLDER=storage/annotated
REPORT_FOLDER=storage/reports
MODEL_FOLDER=models
